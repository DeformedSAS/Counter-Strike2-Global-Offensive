<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/buymenu.css" />
		<include src="file://{resources}/styles/csgostyles_buymenu.css" />
	</styles>
	
	<scripts>
		<include src="file://{resources}/scripts/common/characteranims_loadout_grid.js" />
		<include src="file://{resources}/scripts/common/iteminfo.js" />
		<include src="file://{resources}/scripts/mock_adapter.js" />
		<include src="file://{resources}/scripts/buymenu.js" />
	</scripts>

	<snippets>
		<snippet name="ItemCategory">
			<Panel class="buymenu__category__column">
				<Panel class="buymenu__category__column__header">
					<Label id="WedgeKeybinding" class="buymenu__category__column__keylabel keybind" style="font-family: Stratum2; font-weight: medium;" text="X" />
					<Label id="CategoryName" class="buymenu__category__column__label" text="XXXXX" />
				</Panel>
				<Panel id="ItemButtons" class="buymenu__category__itembuttons" />
			</Panel>
		</snippet>

		<snippet name="ItemPanel">
			<Panel class="button-container">
				<Button id="BuyButton" class="buywheel-wedge">
					<Label id="WedgeKeybinding" class="buywheel-button__key keybind" text="X" />
					<Label id="ItemName" class="buywheel-item__name cl-hud-wash-color" />
					<Image id="ItemIcon" class="buywheel-item__icon cl-hud-wash-color" scaling="stretch-to-fit-preserve-aspect" />
					<Label id="ItemPrice" class="buywheel-item__price cl-hud-wash-color" />
				</Button>
				<Button id="SellbackButton" class="sellback-button">
					<TooltipPanel tooltip="#BuyMenu_Sellback">
						<Image src="file://{images}/icons/ui/undo.svg" />
					</TooltipPanel>
				</Button>
				<Panel id="TeammateInventory" class="teammate-inventory-container" />
			</Panel>
		</snippet>

		<snippet name="snippet-player-pip">
			<Panel class="player-pip" />
		</snippet>

		<snippet name="Radial_SixSlot">
			<Panel class='radial-selector Hidden' visible="false">
				<Button class="radial-button w1 no-hover">
					<Image class="wedge" src="file://{images}/masks/wedge_select.svg" texturewidth="364" textureheight="420"/>
					<Panel id="Contents" />
				</Button>
				<Button class="radial-button w2 no-hover">
					<Image class="wedge" src="file://{images}/masks/wedge_select.svg" texturewidth="364" textureheight="420"/>
					<Panel id="Contents" />
				</Button>
				<Button class="radial-button w3 no-hover">
					<Image class="wedge" src="file://{images}/masks/wedge_select.svg" texturewidth="364" textureheight="420"/>
					<Panel id="Contents" />
				</Button>
				<Button class="radial-button w4 no-hover">
					<Image class="wedge" src="file://{images}/masks/wedge_select.svg" texturewidth="364" textureheight="420"/>
					<Panel id="Contents" />
				</Button>
				<Button class="radial-button w5 no-hover">
					<Image class="wedge" src="file://{images}/masks/wedge_select.svg" texturewidth="364" textureheight="420"/>
					<Panel id="Contents" />
				</Button>
				<Button class="radial-button w6 no-hover">
					<Image class="wedge" src="file://{images}/masks/wedge_select.svg" texturewidth="364" textureheight="420"/>
					<Panel id="Contents" />
				</Button>
			</Panel>
		</snippet>

		<snippet name="Radial_FourSlot">
			<Panel class='radial-selector Hidden' visible="false">
				<Button class="radial-button w1 no-hover">
					<Image class="wedge w90" src="file://{images}/masks/wedge_select_quarter.svg" texturewidth="420" textureheight="420"/>
					<Panel class="fourslot" id="Contents" />
				</Button >
				<Button class="radial-button w2 no-hover">
					<Image class="wedge w90" src="file://{images}/masks/wedge_select_quarter.svg" texturewidth="420" textureheight="420"/>
					<Panel class="fourslot" id="Contents" />
				</Button>
				<Button class="radial-button w3 no-hover">
					<Image class="wedge w90" src="file://{images}/masks/wedge_select_quarter.svg" texturewidth="420" textureheight="420"/>
					<Panel class="fourslot" id="Contents" />
				</Button>
				<Button class="radial-button w4 no-hover">
					<Image class="wedge w90" src="file://{images}/masks/wedge_select_quarter.svg" texturewidth="420" textureheight="420"/>
					<Panel class="fourslot" id="Contents" />
				</Button>
			</Panel>
		</snippet>

		<snippet name="CategoryWedge">
			<Panel class="buywheel-button Hidden" visible="false">
				<Panel class="buywheel-category__contents">
					<Label class="buywheel-category__title" id="CategoryName" text="XXXXX"/>
					<Label class="buywheel-button__key" style="font-family: Stratum2; font-weight: medium;" id="WedgeKeybinding" text="X"/>
				</Panel>
			</Panel>
		</snippet>

		<snippet name="ItemWedge">
			<Panel class="buywheel-button Hidden" visible="false">
				<Label class="buywheel-button__key" style="font-family: Stratum2; font-weight: medium;" id="WedgeKeybinding" text="X"/>
				<Panel class="buywheel-item__textbox">
					<Label id="ItemName" class="buywheel-item__name"/>
					<Image id="ItemIcon" class="buywheel-item__icon"/>
					<Label id="ItemPrice" class="buywheel-item__price"/>
				</Panel>
			</Panel>
		</snippet>

		<snippet name="TeamEquipment">
			<Panel class="team-equip Hidden" visible="false">
				<Panel class="team-equip-padding"/>
				<Image id="Primary" scaling="stretch-to-fit-preserve-aspect" class="team-equip__primary team-equip__flip"/>
				<Panel class="team-equip-other">
					<Panel class="team-equip-gear">
						<Label class="team-equip__money" text="#buymenu_money" />
						<Panel id="OtherItems" class="team-equip__items">
							<Image id="Bomb" scaling="stretch-to-fit-preserve-aspect" class="team-equip__item-icon team-equip__special" texturewidth="-1" textureheight="24"/>
							<Image id="Secondary" scaling="stretch-to-fit-preserve-aspect" class="team-equip__item-icon team-equip__secondary team-equip__flip" texturewidth="-1" textureheight="24"/>
							<Panel id="Grenades" class="left-right-flow vertical-center" texturewidth="-1" textureheight="24"></Panel>
							<Image id="Defuser" scaling="stretch-to-fit-preserve-aspect" src="file://{images}/icons/ui/defuser.svg" class="cl-hud-wash-color team-equip__item-icon"/>
							<Panel class="no-flow vertical-center">
								<Image id="Vest" scaling="stretch-to-fit-preserve-aspect" src="file://{images}/icons/ui/shield.svg" class="team-equip__item-icon team-equip__item-vest" texturewidth="-1" textureheight="24"/>
								<Image id="VestHelm" scaling="stretch-to-fit-preserve-aspect" src="file://{images}/icons/ui/armor.svg" class="team-equip__item-icon team-equip__item-vest" texturewidth="-1" textureheight="24"/>
								<Image id="HeavyAssault" scaling="stretch-to-fit-preserve-aspect" src="file://{images}/icons/ui/armor.svg" class="team-equip__item-icon team-equip__item-vest" texturewidth="-1" textureheight="24"/>
							</Panel>
						</Panel>
					</Panel>
					<Panel class="no-flow horizontal-align-right">
						<CSGOAvatarImage id="Avatar" class="team-equip__avatar" texturewidth="-1" textureheight="32"/>
						<Image id="Skull" class="team-equip__avatar--skull" src="file://{images}/icons/ui/elimination.svg" texturewidth="-1" textureheight="24"/>
						<Image id="PlayerColor" class="player-color" src="file://{images}/hud/teamcounter/teamcounter_playercolor.png"/>
					</Panel>
				</Panel>
			</Panel>
		</snippet>
	</snippets>

	<CSGOBuyMenu class="buymenu">
		<Panel class="buymenu__fullscreen">
			<ItemPreviewPanel id="id-buymenu-agent" class="buymenu-agent" mouse_rotate="false" hittest="true" manifest="resource/ui/econ/ItemModelPanelCharWeaponInspect.res" item="models/player/custom_player/legacy/ctm_sas.mdl" enable_floorshadow="false" force-no-composition-layer="true" />
				
			<Panel class="full-width full-height debug" hittest="false" hittestchildren="false">
				<CSGOHudWeaponSelection id="EmbeddedHudWeaponSelection" neverfade="true" neverselected="true" class="embedded-weapons-overview" />
			</Panel>
			
			<Panel class="buymenu-money">
				<CSGOMoneyPanel id="BuyMenuMoney" class="" />
			</Panel>

			<Panel class="buymenu__contents">
				<Panel class="buymenu-left">
					<Panel class="buymenu-info">
						<CSGOMoneyPanel id="buymenu-info-money" class="" hittest="false" />
						<Panel class="buymenu-timeleft">
							<Label class="buymenu-timeleft-title" text="#BuyMenu_TimerText" />
							<CountdownTimer id="Countdown" output_milliseconds="false" class="buymenu-timeleft-timer">
								<Label text="{t:d:duration}" />
							</CountdownTimer>
						</Panel>
					</Panel>

					<Panel class="buymenu-body">
						<Image class="buy-wheel-background" />
						<Panel class="buymenu__categories__container">
                              <Panel id="CategoryContainer1" class="buymenu-category ccequip" />
                              <Panel id="CategoryContainer2" class="buymenu-category ccpistols" />
                              <Panel id="CategoryContainer3" class="buymenu-category ccsmgs" />
                              <Panel id="CategoryContainer4" class="buymenu-category ccheavy" />
                              <Panel id="CategoryContainer5" class="buymenu-category ccrifles" />
                              <Panel id="CategoryContainer6" class="buymenu-category ccgrenades" />
						</Panel>

						<Panel id="BuyWheelContainer" class="Hidden" visible="false" />
						<Image id="TeamLogo" class="team-logo Hidden" visible="false" src="file://{images}/icons/ct_logo.svg"/>
					</Panel>

					<Panel class="buymenu__purchase-failure-container">
						<Label id="PurchaseFailureLabel" class="buymenu__purchase-failure" />
						<Label id="BuyForTeammateHintLabel" class="buymenu__purchase-failure buymenu__purchase-failure--teammate Hidden" text="#BuyMenu_BuyForTeammate_hint" />
					</Panel>

					<Panel class="team-equip-container--all Hidden" visible="false">
						<Panel id="LocalPlayerEquipment" class="team-equip--self" />
						<Panel id="TeamEquipment" class="team-equip-container" />
					</Panel>
				</Panel>

				<Panel class="buymenu-right">

					<Panel id="ItemDesc" class="buymenu-item-info Hidden">
						<Label id="WeaponNameAndRarity" class="buymenu-item-info__name" text="{s:item-name}" />
						<Label id="ItemDescLabel" class="buymenu-item-info__desc" text="{s:item-desc}" html="true" />
					</Panel>
					<Panel class="vline" />
				</Panel>
			</Panel>

			<Panel id="BuyMenuNavBar" class="buymenu-navbar cl-hud-wash-color">
				<Panel class="vertical-center left-right-flow horizontal-align-right">
					<Label id="BuyForTeammateLabel" class="buymenu__for-teammate" text="#BuyMenu_BuyForTeammate" />
					<Button class="PopupButton" onactivate="GameInterfaceAPI.ConsoleCommand( 'rebuy' )">
						<Label text="#BuyMenu_Buyprev" />
					</Button>
					<Button class="PopupButton" onactivate="GameInterfaceAPI.ConsoleCommand( 'autobuy' )">
						<Label text="#BuyMenu_Autobuy" />
					</Button>
					<Button class="PopupButton" onactivate="$.DispatchEvent( 'BuyMenu_Back' );">
						<Label text="#BuyMenu_Back" />
					</Button>
				</Panel>
			</Panel>
		</Panel>

		<Panel class='buymenu__fullscreen Hidden' visible="false">
			<Panel class="buymenu-info">
				<Panel class="horizontal-center fit-children left-right-flow">
					<Panel class="left-right-flow horizontal-align-right">
						<Label class="buymenu-timeleft-title" text="#BuyMenu_TimerText"/>
						<CountdownTimer id="Countdown" output_milliseconds="false" class="buymenu-timeleft">
							<Label text="{t:d:duration}"/>
						</CountdownTimer>
					</Panel>
				</Panel>
			</Panel>

			<Panel class='buymenu__contents'>
				<Panel class="buymenu-left">
					<Panel class="buymenu-body">
						<Panel class="buy-wheel-background" />
						<Panel id="BuyWheelContainer" class="buy-wheel" />
						<Image id="TeamLogo" class="team-logo" src="file://{images}/icons/ct_logo.svg"/>
					</Panel>
					<Panel class="buymenu__purchase-failure-container">
						<Label id="PurchaseFailureLabel" class="buymenu__purchase-failure" />
						<Label id="BuyForTeammateHintLabel" class="buymenu__purchase-failure buymenu__purchase-failure--teammate Hidden" text="#BuyMenu_BuyForTeammate_hint"/>
					</Panel>

					<Panel class="team-equip-container--all">
						<Panel id="LocalPlayerEquipment" class="team-equip--self"/>
						<Panel id="TeamEquipment" class="team-equip-container" />
					</Panel>
				</Panel>

				<Panel class="buymenu-right">
					<Panel class="vline" />

					<Panel id="PreviewPanelContainer" class="">
						<Panel class="hrTop" />
						<Panel class="category-preview"> 
							<Label text="{s:category}" class="category-preview__label"/>
							<Panel id="CategoryPreview" class="category-image-container" />
						</Panel>

						<Panel id="ItemStatsDisplay" class="stat-display">
							<Panel id="WeaponNameAndRarity" class="rarity-bar">
								<Label class="stat-display__item-name" text="{s:item_name}" />
							</Panel>
							<Panel id="WeaponStats" class="weapon-stats">
								<Panel class="stat-display__row">
									<Label class="stat-display__name" text="#SFUI_BuyMenu_AmmoLabel"/>	
									<Label class="stat-display__value" text="{d:r:ammo_per_mag}/{d:r:ammo_total}"/>	
								</Panel>
								<Panel class="stat-display__row">
									<Label class="stat-display__name" text="#SFUI_BuyMenu_KillAward"/>	
									<Panel class="horizontal-align-right no-flow">
										<Label class="stat-display__value stat-display__kill-reward" text="#buymenu_killaward_amount"/>	
										<Label class="stat-display__value stat-display__points" text="#SFUI_BuyMenu_KillAward_DMPoints_panorama"/>	
									</Panel>
								</Panel>
								<TooltipPanel class="no-flow full-width" tooltip="#buymenu_tooltip_damage">
									<ProgressBar id="DmgProgress" class="stat-display__row" min="0" max="100"/>
									<Label class="stat-display__name" text="#SFUI_BuyMenu_Damage"/>	
									<Label class="stat-display__value" text="#Pano_BuyMenu_Damage_val"/>
								</TooltipPanel>
								<TooltipPanel class="no-flow full-width" tooltip="#buymenu_tooltip_firerate">
									<ProgressBar id="FireRateProgress" class="stat-display__row" min="0" max="15"/>
									<Label class="stat-display__name" text="#SFUI_BuyMenu_FireRate"/>
									<Label class="stat-display__value" text="#Pano_BuyMenu_FireRate_val"/>
								</TooltipPanel>
								<TooltipPanel class="no-flow full-width" tooltip="#buymenu_tooltip_accuracy">
									<ProgressBar id="AccuracyProgress" class="stat-display__row" min="0" max="100"/>
									<Label class="stat-display__name" text="#SFUI_BuyMenu_Accuracy"/>	
									<Label class="stat-display__value" text="#Pano_BuyMenu_Accuracy_val"/>
								</TooltipPanel>
								<TooltipPanel class="no-flow full-width" tooltip="#buymenu_tooltip_range">
									<ProgressBar id="RangeProgress" class="stat-display__row" min="0" max="76"/>
									<Label class="stat-display__name" text="#SFUI_BuyMenu_Range"/>	
									<Label class="stat-display__value" text="#Pano_BuyMenu_Range_val"/>
								</TooltipPanel>
								<TooltipPanel class="no-flow full-width" tooltip="#buymenu_tooltip_armorpen">
									<ProgressBar id="ArmorPenProgress" class="stat-display__row" min="90" max="200"/>
									<Label class="stat-display__name" text="#SFUI_BuyMenu_ArmorPen"/>
									<Label class="stat-display__value" text="#Pano_BuyMenu_ArmorPen_val"/>
								</TooltipPanel>
							</Panel>
							<Label id="ItemDesc" class="stat-display__desc" text="{s:desc}"/> 
						</Panel>
					</Panel>
				</Panel>
			</Panel>

			<Panel id="BuyMenuNavBar" class="cl-hud-wash-color buymenu-navbar pccontrols">
				<Panel class="vertical-center left-right-flow horizontal-align-right">
					<Label id="BuyForTeammateLabel" class="buymenu__for-teammate" style="font-family: Stratum2; font-weight: bold;" text="#BuyMenu_BuyForTeammate" html="true"/>
					<Button class="PopupButton" onactivate="GameInterfaceAPI.ConsoleCommand( 'rebuy' )">
						<Label text="#BuyMenu_Buyprev" html="true" />
					</Button>
					<Button class="PopupButton" onactivate="GameInterfaceAPI.ConsoleCommand( 'autobuy' )">
						<Label text="#BuyMenu_Autobuy" html="true"/>
					</Button>
				</Panel>
				<Panel class="vertical-center left-right-flow horizontal-align-left">
					<Button class="PopupButton" onactivate="$.DispatchEvent( 'BuyMenu_Back' );">
						<Label text="#BuyMenu_Back" html="true"/>
					</Button>
				</Panel>
			</Panel>

			<Panel id="BuyMenuNavBarConsole" class="buymenu-navbar consolecontrols">
				<Panel class="vertical-center left-right-flow horizontal-align-right">
					<CCSGOSteamInputAction actionset="BuyMenuLayer" action="rebuy" separatortext="/" />
					<CCSGOSteamInputActionLabel actionset="BuyMenuLayer" action="rebuy" separatortext="/" />
					<CCSGOSteamInputAction actionset="BuyMenuLayer" action="buy" separatortext="/" />
					<CCSGOSteamInputActionLabel actionset="BuyMenuLayer" action="buy" separatortext="/" />
				</Panel>
				<Panel class="vertical-center left-right-flow horizontal-align-left">
					<CCSGOSteamInputAction actionset="BuyMenuLayer" action="donate" separatortext="/" />
					<CCSGOSteamInputActionLabel actionset="BuyMenuLayer" action="donate" controllernumber = "1"/>
					<CCSGOSteamInputAction actionset="BuyMenuLayer" action="autobuy" separatortext="/" />
					<CCSGOSteamInputActionLabel actionset="BuyMenuLayer" action="autobuy" separatortext="/" />
				</Panel>
			</Panel>

			<Panel class="buymenu-money">
				<CSGOMoneyPanel id="BuyMenuMoney" class="cl-hud-wash-color money__buymenu"/>
			</Panel>
			<Panel id="HudBottomRight" hittest="false" hittestchildren="false">
				<CSGOHudWeaponSelection id="HudWeaponSelection"
					neverfade="true" neverselected="true"
					class="embedded-weapons-overview"/>
			</Panel>
		</Panel>
	</CSGOBuyMenu>
</root>