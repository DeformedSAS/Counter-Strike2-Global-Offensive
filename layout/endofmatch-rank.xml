<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/endofmatch-rank.css" />
		<include src="file://{resources}/styles/endofmatch-skillgroup.css" />
		<include src="file://{resources}/styles/endofmatch-win.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/endofmatch-rank.js" />
	</scripts>
    <snippets>
        <snippet name="snippet_rank__lister__item">
            <Panel class="eom-rank__lister__item eom-rank__lister__item--appear">
                <Label id="id-eom-rank__lister__item__amt" class="eom-rank__lister__item__amt stratum-font" />
                <Label id="id-eom-rank__lister__item__desc" class="eom-rank__lister__item__desc stratum-font" />
            </Panel>
        </snippet>
    </snippets>
    <CSGOEndOfMatchXpPanel class="eom-rank full-width full-height" useglobalcontext="true">
        <Panel class="eom-rank-data">
            <Panel class="eom-rank-data-bg">
                <Panel class="eom-win__main__line" />
                <Panel class="eom-win__main__line vertical-align-bottom" />
            </Panel>
            <Panel id="id-eom-rank__current" class="left-right-flow horizontal-center">
                <Panel class="eom-rank-current-icon">
                    <Image id="id-eom-rank__current__emblem" />
                </Panel>
                <Panel class="eom-skillgroup__info-bar-label-container">
                    <Label id="id-eom-rank__current__label" class="eom-skillgroup__info-label" text="#XP_RankName_Display">
                        <Image texturewidth="-1" textureheight="8" class="eom-win__main__bracket eom-win__main__bracket--top-right" src="file://{images}/hud/bracket.svg" />
                        <Image texturewidth="-1" textureheight="8" class="eom-win__main__bracket eom-win__main__bracket--bottom-right" src="file://{images}/hud/bracket.svg" />
                        <Image texturewidth="-1" textureheight="8" class="eom-win__main__bracket eom-win__main__bracket--top-left" src="file://{images}/hud/bracket.svg" />
                        <Image texturewidth="-1" textureheight="8" class="eom-win__main__bracket eom-win__main__bracket--bottom-left" src="file://{images}/hud/bracket.svg" />
                    </Label>
                    <Panel id="id-eom-rank__bar-container">
                        <Panel id="id-eom-rank__bar--bg" class="eom-rank__bar" />
                        <Panel id="id-eom-rank__bar" class="eom-rank__bar">
                            <Panel id="id-eom-rank__lister" class="eom-rank__lister">
                                <Panel id="id-eom-rank__lister__line" class="eom-rank__lister__line" />
                                <Panel id="id-eom-rank__lister__items" class="eom-rank__lister__items" />
                            </Panel>
                        </Panel>
                        <Panel id="id-eom-rank-bar-white" class="eom-rank__bar--white" />
                    </Panel>
                </Panel>
            </Panel>
        </Panel>
        <Panel id="id-eom-new-reveal" class="eom-rank-new-reveal hidden">
		    <ItemPreviewPanel 	id="RankParticleModel"
				   class="eom-skillgroup__particles hidden"
				   manifest="resource/ui/econ/ItemModelPanelCharWeaponInspect.res"
				   item=""
				   mouse_rotate="false"/>
            <Image class="eom-rank-new-reveal__flag" src="file://{images}/ui_textures/rankup_flag.png" />
            <Image class="eom-rank-new-reveal__flare-halo" src="file://{images}/ui_textures/rankup_flare_halo.png" />
            <Image id="id-eom-new-reveal-image" class="eom-rank-new-reveal__image" src="file://{images}/icons/xp/level5.png" />
        </Panel>
    </CSGOEndOfMatchXpPanel>
</root>