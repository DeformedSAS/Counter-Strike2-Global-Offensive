<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/mainmenu.css" />
		<include src="file://{resources}/styles/loadingscreen.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/loadingscreen.js" />
	</scripts>
    <snippets>
        <snippet name="snippet-loadingscreen-slide">
            <Image class="loading-screen-slide" scaling="stretch-to-cover-preserve-aspect">
                <Label id="LoadingScreenTitle" class="loading-screen-screenshot-title stratum-regular-condensed" text="{s:screenshot-title}" />
            </Image>
        </snippet>
    </snippets>
    <Panel class="loading-root">
        <CSGOBlurTarget id="BackgroundMapImageBlur" class="loading-screen-blur" blurrects="LoadingScreenContents">
            <Image id="BackgroundMapImage" class="full-width full-height defaultbg" src="file://{images}/map_icons/screenshots/1080p/default.png" scaling="stretch-to-cover-preserve-aspect" />
            <Panel id="LoadingScreenSlideShow" class="full-width full-height" />
        </CSGOBlurTarget>
        <Panel class="mainmenu-content">
            <Panel id="loadingscreen__blur-target" />
        </Panel>
        <Panel id="LoadingScreenContents" acceptsinput="true" acceptsfocus="true" class="loading-screen-contents">
            <Panel id="LoadingScreenContentsBottom" class="loading-screen-contents-bottom">
                <Panel id="LoadingScreenInfo" class="loading-screen-content__info hidden">
                    <Image id="LoadingScreenIcon" class="loading-screen__mapicon" src="" scaling="stretch-to-cover-preserve-aspect" texturewidth="128" textureheight="128" />
                    <Panel class="loading-screen-content__info-container">
                        <Panel class="loading-screen-content__titles">
                            <Label id="LoadingScreenMapName" class="loading-screen-content__info__text-title stratum-bold-condensed" text="XXXX XX" />
                            <Panel id="LoadingScreenGamemodeInfo" class="loading-screen-content__info__gamemode">
                                <Image id="LoadingScreenGameModeIcon" class="loading-screen-content__info__modeicon" src="" scaling="stretch-to-cover-preserve-aspect" texturewidth="40" textureheight="40" />
                                <Label id="LoadingScreenGameMode" class="loading-screen-content_text-gamemode stratum-medium-condensed" text="" />
                            </Panel>
                        </Panel>
                    </Panel>
                    <Panel id="BlaBlaTrucSeperator" class="loading-screen-content__info-line" />
                    <Label id="LoadingScreenModeDesc" class="loading-screen-content__info__text"  html="true" text="" />
                </Panel>
            </Panel>
            <Panel id="LoadingScreenHintContents" class="loading-screen-hint-contents">
                <Image src="s2r://panorama/images/icons/ui/info.vsvg" class="loading-screen-hint__icon" />
                <Label id="LoadingScreenHintText" class="loading-screen-hint__text" html="true" text="#SFUI_Hint_WeaponSlowdown" />
            </Panel>
            <Panel class="loading-screen-progress-container">
			    <Label id="ProgressStatusText" class="loading-screen-progress-text stratum-medium-condensed" style="visibility: collapse;" text="" html="true" />
                <Label id="ProgressStatusTextFun" class="loading-screen-progress-text stratum-medium-condensed" text="#SFUI_LOADING" html="true" />
                <Panel id="LoadingSecondaryProgressContainer" class="loading-screen-progress-secondary-container">
                    <Label id="ProgressSecondaryStatusText" class="loading-screen-progress-secondary-text" text="#SFUI_LOADING" />
                    <ProgressBar id="ProgressBarSecondary" />
                </Panel>
                <ProgressBar id="ProgressBar" />
            </Panel>
        </Panel>
        <Panel id="" class="full-width full-height" />
    </Panel>
</root>
