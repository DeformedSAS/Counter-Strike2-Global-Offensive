<root>
	<styles>
		<include src="file://{resources}/styles/csgostyles.css" />
		<include src="file://{resources}/styles/mainmenu.css" />
    	<include src="file://{resources}/styles/popups/popups_shared.css" />
  	</styles>
  	<script>
		function executeJs()
		{
			eval($.GetContextPanel().FindChildInLayoutFile('TextEntry').text);
		}
  	</script>

  	<Panel class="PopupPanel Hidden" popupbackground="dim">
  		<Label class="PopupTitle" text="Custom JS code execute" />
		<TextEntry id="TextEntry"
						style="margin: 8px; width: 100%;"
						ontextentrysubmit="executeJs()"/>
		<Panel class="PopupButtonRow">
			<TextButton class="PopupButton" text="OPEN CONSOLE" onactivate="GameInterfaceAPI.ConsoleCommand( 'toggleconsole' )" />
			<TextButton class="PopupButton" text="#UI_Cancel" onactivate="$.DispatchEvent( 'UIPopupButtonClicked', '' );" />
		</Panel>
  	</Panel>
</root>
