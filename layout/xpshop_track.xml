<root>
    <styles>
        <include src="file://{resources}/styles/csgostyles.css" />
        <include src="file://{resources}/styles/xpshop_track.css" />
        <include src="file://{resources}/styles/particle_controls.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/common/async.js" />
        <include src="file://{resources}/scripts/xpshop_track.js" />
    </scripts>
    <Panel class="xpshop-track-root" useglobalcontext="true">
        <TooltipPanel tooltip="{s:xpshop-track-tooltip}" class="horizontal-center">
            <Panel class="top-bottom-flow full-width full-heigth">
                <Panel class="xst-radial-container">
                    <Panel class="xst-bg" />
                    <Panel id="jsRadialTrack" class="radial-track" />
                    <Panel id="jsStarEarned" class="star" />
                </Panel>
                <Label class="xst-total" text="#xpshop_track_mini_stars_counter" />
            </Panel>
        </TooltipPanel>
    </Panel>
</root>